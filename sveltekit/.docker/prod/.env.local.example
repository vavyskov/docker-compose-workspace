COMPOSE_PROJECT_NAME=prod_sveltekit

PROJECT_HOSTNAME=sveltekit.example.com
PROJECT_ROOT=/var/www/html
PROJECT_MODE=prod

HOST_USER_ID=1003

CERTIFICATE_PATH=/etc/ssl/certificates
CERTIFICATE_FILENAME=example.com.crt
CERTIFICATE_KEYNAME=example.com.key
#CERTIFICATE_CA_1=ca_1.crt
#CERTIFICATE_CA_2=ca_2.crt
#CERTIFICATE_CA_3=ca-3.crt

USER_NAME=sveltekit
USER_PASSWORD=PRODSVELTEKIT

NODE_VERSION=20-1.0.1

SMTP_HOSTNAME=email.example.com
SMTP_PORT=25
SMTP_FROM=user@example.com
SMTP_USER=user
SMTP_PASSWORD=PRODSMTPPASSWORD

SSH_HOME=/var/www
SSH_PORT=2254

GIT_EMAIL=my@email.com
GIT_NAME="My Name"

## Proxy server example: http://USER:PROXYPASSWORD@proxy.example.com:8080
PROXY_SERVER=

NFS_HOSTNAME=nfs.example.com
NFS_PATH=/media/nfs_docker/prod
